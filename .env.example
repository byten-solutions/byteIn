# ==============================================================================
# byteInn Environment Configuration Template
# ==============================================================================

# Database Connection (REQUIRED in Vercel Production & Preview)
# On Vercel / serverless runtimes, point this to your transaction connection pooler.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/byteinn?schema=public"

# Session Security (REQUIRED in Vercel Production & Preview)
# Must be a cryptographically random string of at least 32 characters.
# Generate via: openssl rand -base64 32
SESSION_SECRET="replace-with-a-secure-random-32-char-string-in-production"

# Runtime Environment (Defaulted automatically by Vercel)
NODE_ENV="development"
PORT="3000"

# Optional: Isolated Test Runner Database URL (Local Testing Only)
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/byteinn_test?schema=public"

# Optional: Custom seed password overrides for local development seeding
# SEED_ADMIN_PASSWORD="replace-with-custom-seed-password-min-12-chars"
# SEED_RECEPTIONIST_PASSWORD="replace-with-custom-seed-password-min-12-chars"
