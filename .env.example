# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://byteinn_user:byteinn_password@localhost:5432/byteinn?schema=public"

# Application configuration
NODE_ENV="development"
PORT="3000"

# Authentication session secret (must be at least 32 characters in production)
SESSION_SECRET="byteinn-development-session-secret-min-32-chars-long"

# Database seed credentials (optional overrides for prisma/seed.ts)
# SEED_ADMIN_PASSWORD="Admin@123456"
# SEED_RECEPTIONIST_PASSWORD="Reception@123456"
